# Copiá este archivo a .env.local (Vite lo carga automático y .env.local
# ya está en .gitignore, así que nunca se sube al repo) y completá los dos
# valores con los de tu proyecto de Supabase: Project Settings → API.
#
# VITE_SUPABASE_URL es la "Project URL".
# VITE_SUPABASE_ANON_KEY es la "anon public" key (NO la "service_role" —
# esa es secreta y nunca debe usarse en el frontend).
#
# Ver supabase/README.md para los pasos completos, incluyendo cómo crear
# tu usuario de acceso al panel de administración (/notas-profe).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Formulario de "Sugerencias" del footer (opcional — si no completás estos
# tres valores, esa sección simplemente no aparece). Son públicas por
# diseño, igual que la anon key de arriba. Ver supabase/README.md, "Fase 7".
VITE_EMAILJS_SERVICE_ID=tu-service-id
VITE_EMAILJS_TEMPLATE_ID=tu-template-id
VITE_EMAILJS_PUBLIC_KEY=tu-public-key
